; Dustbound Frontier - Original Western Action-Adventure prototype
; Open this folder using Godot 4.3+ Project Manager.
config_version=5

[application]
config/name="Dustbound Frontier"
run/main_scene="res://scenes/main.tscn"
config/description="An original playable western frontier prototype."
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
3d/default_gravity=22.0

[filesystem]
import/blender/enabled=false
